{
  "name": "AtlassianConnection",
  "type": "object",
  "properties": {
    "owner_user_id": {"type": "string"},
    "provider": {"type": "string", "enum": ["Jira", "Confluence", "Jira + Confluence"]},
    "cloud_id": {"type": "string"},
    "site_url": {"type": "string"},
    "site_name": {"type": "string"},
    "account_id": {"type": "string"},
    "scope": {"type": "string"},
    "webhooks_registered": {"type": "boolean", "default": false},
    "webhook_ids": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["owner_user_id", "provider"]
}